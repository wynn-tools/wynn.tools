    "vue-router": "^5.0.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/fonts": "^0.14.0",
    "@tailwindcss/vite": "^4.3.0",
    "@takumi-rs/core": "^1.5.1",
    "@takumi-rs/wasm": "^1.5.1",
